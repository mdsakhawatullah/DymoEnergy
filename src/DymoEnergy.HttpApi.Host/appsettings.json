{
  "App": {
    "SelfUrl": "https://localhost:44371",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.DymoEnergy.com,http://localhost:4200,http://localhost:4200/",
    "RedirectAllowedUrls": "http://localhost:4200,http://localhost:4200/",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=DymoEnergy;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AuthServer": {
    "Authority": "https://localhost:44371",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "DymoEnergy_Swagger",
    "CertificatePassPhrase": "cd1f05f8-94df-4dde-b109-daeea78e24ad"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "VPGD7REt4UORfXsc"
  }}