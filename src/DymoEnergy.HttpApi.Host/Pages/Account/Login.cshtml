@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Web.Pages.Account
@model LoginModel
@inject IHtmlLocalizer<AccountResource> L
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In &mdash; Dymo Energy</title>
    <link rel="stylesheet" href="~/libs/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/libs/@@fortawesome/fontawesome-free/css/all.css" />
    <style>
        :root {
            --clr-dark:   #0D5C2E;
            --clr-mid:    #1A8A40;
            --clr-teal:   #00B4A6;
            --clr-teal-lt:#7DD8D1;
            --clr-bg:     #F4FAF7;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            display: flex;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--clr-bg);
        }

        /* ── LEFT PANEL ─────────────────────────────── */
        .de-left {
            flex: 0 0 48%;
            background: linear-gradient(145deg, var(--clr-dark) 0%, var(--clr-mid) 55%, var(--clr-teal) 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 3rem 3rem 2rem;
            position: relative;
            overflow: hidden;
            color: #fff;
        }

        /* decorative circles */
        .de-left::before,
        .de-left::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            opacity: .12;
            background: #fff;
        }
        .de-left::before { width: 420px; height: 420px; top: -120px; right: -130px; }
        .de-left::after  { width: 280px; height: 280px; bottom: -80px; left: -90px; }

        .de-brand { text-align: center; z-index: 1; }

        /* ── inline text logo ── */
        .de-logo {
            display: inline-flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: 1.1rem;
        }
        .de-logo-icon {
            width: 54px; height: 54px;
            background: #fff;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 2rem; font-weight: 900;
            color: var(--clr-dark);
            box-shadow: 0 4px 14px rgba(0,0,0,.18);
            flex-shrink: 0;
            position: relative;
        }
        /* small dot badge – mirrors WafiSoft style */
        .de-logo-icon::after {
            content: '';
            width: 10px; height: 10px;
            background: var(--clr-teal);
            border: 2px solid #fff;
            border-radius: 50%;
            position: absolute;
            top: -3px; right: -3px;
        }
        .de-logo-text {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            line-height: 1.1;
        }
        .de-logo-name {
            font-size: 1.65rem; font-weight: 800;
            color: #fff;
            letter-spacing: .2px;
        }
        .de-logo-sub {
            font-size: .85rem; font-weight: 400;
            color: rgba(255,255,255,.78);
            letter-spacing: .4px;
        }

        .de-brand p {
            font-size: .93rem; opacity: .8; margin-top: .5rem; line-height: 1.55;
        }

        /* dashboard illustration placeholder */
        .de-illustration {
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            width: 100%;
            max-width: 380px;
        }
        .de-mockup {
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.22);
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            width: 100%;
            backdrop-filter: blur(6px);
        }
        .de-mockup-bar {
            display: flex; gap: .5rem; margin-bottom: .9rem;
        }
        .de-dot {
            width: 10px; height: 10px; border-radius: 50%;
            background: rgba(255,255,255,.45);
        }
        .de-mockup-grid {
            display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .55rem;
        }
        .de-card-sm {
            background: rgba(255,255,255,.18);
            border-radius: 7px; padding: .5rem .6rem;
        }
        .de-card-sm .de-line {
            height: 7px; border-radius: 4px; background: rgba(255,255,255,.5);
            margin-bottom: 5px;
        }
        .de-card-sm .de-line:last-child { width: 60%; margin-bottom: 0; }

        .de-stats {
            display: flex; gap: .75rem; width: 100%;
        }
        .de-stat-box {
            flex: 1; background: rgba(255,255,255,.12);
            border-radius: 10px; padding: .75rem;
            text-align: center;
            border: 1px solid rgba(255,255,255,.18);
        }
        .de-stat-box .de-stat-val {
            font-size: 1.15rem; font-weight: 700;
        }
        .de-stat-box .de-stat-lbl {
            font-size: .7rem; opacity: .75; margin-top: 2px;
        }
        .de-stat-box.teal { background: rgba(0,180,166,.28); border-color: rgba(0,180,166,.4); }

        .de-tagline {
            z-index: 1;
            text-align: center;
            font-size: .88rem;
            opacity: .8;
            letter-spacing: .3px;
        }

        /* ── RIGHT PANEL ────────────────────────────── */
        .de-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1.5rem;
            background: var(--clr-bg);
        }

        .de-card {
            background: #fff;
            border-radius: 18px;
            padding: 2.75rem 2.5rem 2.5rem;
            width: 100%;
            max-width: 430px;
            box-shadow: 0 8px 40px rgba(13,92,46,.1);
        }

        /* card top icon */
        .de-card-icon {
            width: 48px; height: 48px;
            background: linear-gradient(135deg, var(--clr-teal-lt), var(--clr-teal));
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 1.1rem;
            color: #fff; font-size: 1.2rem;
        }
        .de-card h2 {
            font-size: 1.65rem; font-weight: 700;
            color: var(--clr-dark); margin-bottom: .3rem;
        }
        .de-card .de-sub {
            font-size: .88rem; color: #6b7280; margin-bottom: .2rem;
        }
        .de-accent-line {
            height: 3px; width: 48px;
            background: linear-gradient(90deg, var(--clr-teal), var(--clr-mid));
            border-radius: 2px; margin: 1rem 0 1.7rem;
        }

        /* form */
        .de-label {
            display: block;
            font-size: .7rem; font-weight: 700;
            letter-spacing: .8px; text-transform: uppercase;
            color: #6b7280; margin-bottom: .5rem;
        }
        .de-input-wrap {
            position: relative; margin-bottom: 1.1rem;
        }
        .de-input-wrap .de-ico {
            position: absolute; left: .9rem; top: 50%;
            transform: translateY(-50%);
            color: #9ca3af; font-size: .85rem; pointer-events: none;
        }
        .de-input-wrap input {
            width: 100%;
            padding: .72rem .9rem .72rem 2.4rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 9px;
            font-size: .93rem;
            color: #374151;
            background: #fafafa;
            transition: border-color .2s, box-shadow .2s;
            outline: none;
        }
        .de-input-wrap input:focus {
            border-color: var(--clr-teal);
            box-shadow: 0 0 0 3px rgba(0,180,166,.12);
            background: #fff;
        }
        .de-input-wrap .de-eye {
            position: absolute; right: .9rem; top: 50%;
            transform: translateY(-50%);
            background: none; border: none; cursor: pointer;
            color: #9ca3af; font-size: .85rem; padding: 0;
        }
        .de-input-wrap .de-eye:hover { color: var(--clr-teal); }

        .de-row {
            display: flex; align-items: center;
            justify-content: space-between; margin-bottom: 1.5rem;
        }
        .de-check-label {
            display: flex; align-items: center; gap: .5rem;
            font-size: .87rem; color: #4b5563; cursor: pointer;
        }
        .de-check-label input[type=checkbox] {
            width: 15px; height: 15px; accent-color: var(--clr-teal);
        }
        .de-forgot {
            font-size: .87rem; font-weight: 600;
            color: var(--clr-teal); text-decoration: none;
        }
        .de-forgot:hover { color: var(--clr-mid); text-decoration: underline; }

        .de-btn {
            width: 100%;
            padding: .8rem;
            background: linear-gradient(135deg, var(--clr-mid), var(--clr-dark));
            color: #fff;
            border: none; border-radius: 10px;
            font-size: .97rem; font-weight: 600;
            letter-spacing: .3px;
            cursor: pointer;
            transition: opacity .2s, transform .1s;
            display: flex; align-items: center; justify-content: center; gap: .6rem;
        }
        .de-btn:hover  { opacity: .88; }
        .de-btn:active { transform: scale(.985); }

        /* validation summary */
        .de-alert {
            background: #fef2f2; border: 1px solid #fecaca;
            border-left: 4px solid #ef4444;
            border-radius: 8px; padding: .75rem 1rem;
            margin-bottom: 1.2rem; font-size: .86rem; color: #b91c1c;
        }
        .de-alert ul { margin: 0; padding-left: 1rem; }

        .de-footer {
            text-align: center; margin-top: 1.5rem;
            font-size: .78rem; color: #9ca3af;
        }

        /* ── RESPONSIVE ─────────────────────────────── */
        @@media (max-width: 820px) {
            .de-left { display: none; }
            .de-right { padding: 2rem 1rem; }
        }
    </style>
</head>
<body>

    <!-- ══ LEFT PANEL ══════════════════════════════════════════════════ -->
    <div class="de-left">
        <div class="de-brand">
            <div class="de-logo">
                <div class="de-logo-icon">D</div>
                <div class="de-logo-text">
                    <span class="de-logo-name">Dymo Energy</span>
                    
                </div>
            </div>
            <p>Powering tomorrow with clean,<br />sustainable solar solutions.</p>
        </div>

        <div class="de-illustration">
            <!-- mini dashboard mockup -->
            <div class="de-mockup">
                <div class="de-mockup-bar">
                    <div class="de-dot"></div>
                    <div class="de-dot"></div>
                    <div class="de-dot"></div>
                </div>
                <div class="de-mockup-grid">
                    <div class="de-card-sm">
                        <div class="de-line"></div><div class="de-line"></div>
                    </div>
                    <div class="de-card-sm">
                        <div class="de-line"></div><div class="de-line"></div>
                    </div>
                    <div class="de-card-sm">
                        <div class="de-line"></div><div class="de-line"></div>
                    </div>
                </div>
            </div>
            <div class="de-stats">
                <div class="de-stat-box">
                    <div class="de-stat-val">2.4 MW</div>
                    <div class="de-stat-lbl">Total Capacity</div>
                </div>
                <div class="de-stat-box teal">
                    <div class="de-stat-val">98%</div>
                    <div class="de-stat-lbl">Efficiency</div>
                </div>
                <div class="de-stat-box">
                    <div class="de-stat-val">1,240</div>
                    <div class="de-stat-lbl">Panels Sold</div>
                </div>
            </div>
        </div>

        <p class="de-tagline">One platform for your solar energy business</p>
    </div>

    <!-- ══ RIGHT PANEL ═════════════════════════════════════════════════ -->
    <div class="de-right">
        <div class="de-card">

            <div class="de-card-icon">
                <i class="fas fa-bolt"></i>
            </div>
            <h2>Sign in</h2>
            <p class="de-sub">Welcome back &mdash; enter your credentials to continue</p>
            <div class="de-accent-line"></div>

            @if (!Model.IsExternalLoginOnly)
            {
                <!-- Validation errors -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="de-alert">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="ReturnUrlHash" />

                    <!-- Username / Email -->
                    <label class="de-label">User name or email address</label>
                    <div class="de-input-wrap">
                        <i class="de-ico fas fa-user"></i>
                        <input asp-for="LoginInput.UserNameOrEmailAddress"
                               placeholder="Enter your username or email"
                               autocomplete="username" />
                    </div>

                    <!-- Password -->
                    <label class="de-label">Password</label>
                    <div class="de-input-wrap">
                        <i class="de-ico fas fa-lock"></i>
                        <input asp-for="LoginInput.Password"
                               type="password" id="de-pwd"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button" class="de-eye" id="de-eye-btn" title="Toggle password">
                            <i class="fas fa-eye-slash" id="de-eye-ico"></i>
                        </button>
                    </div>

                    <!-- Remember me + Forgot password -->
                    <div class="de-row">
                        <label class="de-check-label">
                            <input asp-for="LoginInput.RememberMe" type="checkbox" />
                            Remember me
                        </label>
                        <a class="de-forgot" asp-page="./ForgotPassword"
                           asp-route-returnUrl="@Model.ReturnUrl">Forgot password?</a>
                    </div>

                    <!-- Submit -->
                    <button type="submit" name="Action" value="Login" class="de-btn">
                        Sign in to your account
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
            }

            @if (Model.VisibleExternalProviders.Any())
            {
                <div style="margin-top:1.4rem; text-align:center;">
                    <span style="font-size:.8rem;color:#9ca3af;">Or continue with</span>
                    <div style="display:flex;gap:.6rem;justify-content:center;margin-top:.75rem;flex-wrap:wrap;">
                        @foreach (var provider in Model.VisibleExternalProviders)
                        {
                            <form asp-page="./Login" asp-page-handler="ExternalLogin"
                                  asp-route-returnUrl="@Model.ReturnUrl"
                                  asp-route-returnUrlHash="@Model.ReturnUrlHash"
                                  method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="@provider.AuthenticationScheme" />
                                <button type="submit"
                                        style="padding:.5rem 1.1rem;border:1.5px solid #e5e7eb;border-radius:8px;
                                               background:#fff;font-size:.85rem;cursor:pointer;color:#374151;">
                                    @provider.DisplayName
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }

            <div class="de-footer">
                &copy; @DateTime.Now.Year Dymo Energy &bull; All rights reserved.
            </div>
        </div>
    </div>

    <script src="~/libs/jquery/jquery.min.js"></script>
    <script>
        // Password show / hide toggle
        document.getElementById('de-eye-btn').addEventListener('click', function () {
            var pwd = document.getElementById('de-pwd');
            var ico = document.getElementById('de-eye-ico');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                ico.classList.replace('fa-eye-slash', 'fa-eye');
            } else {
                pwd.type = 'password';
                ico.classList.replace('fa-eye', 'fa-eye-slash');
            }
        });
    </script>
</body>
</html>
