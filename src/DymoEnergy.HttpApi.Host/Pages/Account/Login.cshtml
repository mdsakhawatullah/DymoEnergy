@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Web.Pages.Account
@model LoginModel
@inject IHtmlLocalizer<AccountResource> L
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In &mdash; Dymo Energy</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230E6B3F'/%3E%3Cpath d='M8.5 7h7a9 9 0 0 1 0 18h-7z' fill='%23fff'/%3E%3Ccircle cx='16' cy='16' r='3.4' fill='%23F29D12'/%3E%3C/svg%3E" />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        /* DymoEnergy admin sign-in — palette from the design handoff tokens */
        :root {
            --primary:      #0E6B3F;
            --primary-dark: #0B5A34;
            --forest:       #0A3D26;
            --sun:          #F29D12;
            --leaf:         #E6F2EA;
            --ink:          #16201A;
            --text-2:       #2E3A33;
            --muted:        #5F6B63;
            --placeholder:  #7C877F;
            --border:       #E3E6E0;
            --border-soft:  #EEF0EB;
            --border-input: #D8DDD5;
            --surface:      #FFFFFF;
            --surface-2:    #FAFAF8;
            --focus-ring:   #D3EBDC;
            --danger-bg:    #FDECEA;
            --danger-fg:    #B42318;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        /* The sign-in screen is a single viewport-height surface — never scrolls.
           Vertical rhythm is vh-based so it compresses instead of overflowing. */
        html, body { height: 100%; }

        body {
            height: 100vh;
            overflow: hidden;
            display: flex;
            font-family: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
            color: var(--ink);
            background: var(--surface-2);
            -webkit-font-smoothing: antialiased;
        }

        /* ══ LEFT PANEL ═══════════════════════════════════════════════ */
        .de-left {
            flex: 0 0 44%;
            position: relative;
            overflow: hidden;
            min-height: 0;
            padding: clamp(24px, 4.5vh, 40px) 56px clamp(20px, 4vh, 36px);
            display: flex;
            flex-direction: column;
            background: linear-gradient(162deg, #E7F0E9 0%, #F1F6EF 52%, #F6F8F3 100%);
        }

        /* Concentric sun rings, bleeding off the top-right corner */
        .de-rings {
            position: absolute;
            top: -210px;
            right: -170px;
            width: 460px;
            height: 460px;
            pointer-events: none;
            z-index: 0;
        }
        .de-rings span {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(242, 157, 18, 0.16);
        }
        .de-rings span:nth-child(1) { inset: 0; background: rgba(242, 157, 18, 0.07); border: 0; }
        .de-rings span:nth-child(2) { inset: -58px; }
        .de-rings span:nth-child(3) { inset: -116px; }

        /* Lift content above the rings — the rings themselves must stay absolute,
           so exclude them or they fall back into flow and push the panel down. */
        .de-left > *:not(.de-rings) { position: relative; z-index: 1; }

        /* Brand */
        .de-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .de-wordmark {
            font-size: 22px;
            letter-spacing: -0.01em;
            line-height: 1;
        }
        .de-wordmark b { font-weight: 700; color: var(--ink); }
        .de-wordmark span { font-weight: 500; color: var(--primary); }
        .de-admin-pill {
            margin-left: 4px;
            padding: 4px 11px;
            border-radius: 999px;
            background: var(--surface);
            border: 1px solid rgba(14, 107, 63, 0.14);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: var(--primary-dark);
        }

        /* Headline */
        .de-headline {
            margin-top: clamp(28px, 7vh, 68px);
            font-size: clamp(30px, 3.4vw, 42px);
            font-weight: 700;
            line-height: 1.14;
            letter-spacing: -0.025em;
            color: var(--ink);
            max-width: 15ch;
        }
        .de-lede {
            margin-top: clamp(12px, 2vh, 18px);
            font-size: 16px;
            line-height: 1.6;
            color: var(--muted);
            max-width: 46ch;
        }

        /* Dashboard mock */
        .de-mock {
            margin-top: clamp(20px, 4.5vh, 44px);
            width: 100%;
            max-width: 520px;
            flex-shrink: 0;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(16, 32, 26, 0.06);
            overflow: hidden;
        }
        .de-mock-bar {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border-soft);
        }
        .de-mock-bar i {
            width: 8px; height: 8px; border-radius: 50%;
            background: #DDE2DA; display: block;
        }
        .de-mock-bar b {
            margin-left: 10px;
            font-size: 12.5px;
            font-weight: 500;
            color: var(--muted);
        }
        .de-mock-cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            padding: 14px 16px 4px;
        }
        .de-mini {
            border: 1px solid var(--border-soft);
            border-radius: 10px;
            padding: 10px 11px;
        }
        .de-mini u {
            display: block;
            font-size: 10.5px;
            text-decoration: none;
            color: var(--muted);
            margin-bottom: 9px;
        }
        .de-mini s {
            display: block;
            height: 7px;
            border-radius: 4px;
            text-decoration: none;
        }
        .de-mini s.g { width: 74%; background: #BFE0CB; }
        .de-mini s.a { width: 58%; background: #F7D9A2; }
        .de-mini s.b { width: 66%; background: #C4D3F5; }

        .de-rows { padding: 10px 16px 16px; }
        .de-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 0;
            border-top: 1px solid var(--border-soft);
        }
        .de-row:first-child { border-top: 0; }
        .de-sq { width: 22px; height: 22px; border-radius: 7px; flex-shrink: 0; }
        .de-ln { height: 7px; border-radius: 4px; background: #E7EAE4; }
        .de-pl { width: 58px; height: 14px; border-radius: 7px; margin-left: auto; flex-shrink: 0; }

        /* Security strip */
        .de-secure {
            margin-top: auto;
            padding-top: clamp(18px, 3.5vh, 36px);
            display: flex;
            align-items: center;
            gap: 28px;
            flex-wrap: wrap;
            font-size: 13px;
            color: var(--muted);
        }
        .de-secure div { display: inline-flex; align-items: center; gap: 8px; }

        /* ══ RIGHT PANEL ══════════════════════════════════════════════ */
        .de-right {
            flex: 1;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            padding: clamp(20px, 3vh, 32px) 40px clamp(16px, 2.5vh, 24px);
            background: var(--surface-2);
        }

        .de-formwrap {
            flex: 1;
            min-height: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .de-form { width: 100%; max-width: 420px; }

        .de-form h1 {
            font-size: 32px;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--ink);
        }
        .de-form > p.sub {
            margin-top: 6px;
            font-size: 15px;
            color: var(--muted);
        }

        .de-label {
            display: block;
            margin: 22px 0 7px;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
        }
        .de-label-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin: 22px 0 7px;
        }
        .de-label-row .de-label { margin: 0; }
        .de-forgot {
            font-size: 13px;
            font-weight: 600;
            color: var(--primary-dark);
            text-decoration: none;
        }
        .de-forgot:hover { text-decoration: underline; }

        .de-field { position: relative; }
        .de-field > svg.lead {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--placeholder);
            pointer-events: none;
        }
        .de-field input[type="text"],
        .de-field input[type="email"],
        .de-field input[type="password"] {
            width: 100%;
            height: 52px;
            padding: 0 46px;
            border: 1px solid var(--border-input);
            border-radius: 10px;
            background: var(--surface);
            font-family: inherit;
            font-size: 15px;
            color: var(--ink);
            outline: none;
        }
        .de-field input::placeholder { color: var(--placeholder); }
        .de-field input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--focus-ring);
        }
        .de-eye {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 36px; height: 36px;
            border: 0; border-radius: 8px;
            background: transparent;
            color: var(--muted);
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
        }
        .de-eye:hover { background: #F1F3EE; }

        .de-keep {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 18px;
            font-size: 14px;
            color: var(--text-2);
            cursor: pointer;
        }
        .de-keep input {
            width: 18px; height: 18px;
            accent-color: var(--primary);
            cursor: pointer;
        }

        .de-submit {
            width: 100%;
            height: 52px;
            margin-top: 22px;
            border: 0;
            border-radius: 10px;
            background: var(--primary);
            color: #fff;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            transition: background .14s ease;
        }
        .de-submit:hover { background: var(--primary-dark); }

        .de-alert {
            margin-top: 18px;
            padding: 12px 14px;
            border-radius: 10px;
            background: var(--danger-bg);
            color: var(--danger-fg);
            font-size: 13.5px;
            font-weight: 500;
        }
        .de-alert ul { margin: 0; padding-left: 18px; }

        .de-divider {
            margin: 26px 0 18px;
            height: 1px;
            background: var(--border);
        }
        .de-help {
            text-align: center;
            font-size: 13px;
            line-height: 1.7;
            color: var(--muted);
        }
        .de-help a { color: var(--primary-dark); font-weight: 600; }

        .de-ext {
            margin-top: 18px;
            display: flex;
            gap: 8px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .de-ext button {
            height: 40px;
            padding: 0 16px;
            border: 1px solid var(--border-input);
            border-radius: 8px;
            background: var(--surface);
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
            cursor: pointer;
        }
        .de-ext button:hover { background: #F1F3EE; }

        .de-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            font-size: 13px;
            color: var(--placeholder);
        }
        .de-bottom a { color: var(--placeholder); text-decoration: none; }
        .de-bottom a:hover { color: var(--muted); text-decoration: underline; }

        /* ══ Responsive ═══════════════════════════════════════════════ */
        @@media (max-width: 1080px) {
            .de-left { flex: 0 0 40%; padding-left: 36px; padding-right: 36px; }
        }

        /* Short screens drop the mock rather than let the panel overflow */
        @@media (max-height: 740px) {
            .de-mock { display: none; }
        }

        @@media (max-height: 560px) {
            .de-secure { display: none; }
        }

        /* Below this the split stops making sense: show the form only */
        @@media (max-width: 860px) {
            .de-left { display: none; }
            .de-right { flex: 1; padding: 20px 24px 16px; }
        }
    </style>
</head>
<body>

    <!-- ══ LEFT ════════════════════════════════════════════════════════ -->
    <div class="de-left">
        <div class="de-rings"><span></span><span></span><span></span></div>

        <div class="de-brand">
            <svg width="40" height="40" viewBox="0 0 32 32" aria-hidden="true">
                <rect width="32" height="32" rx="8" fill="#0E6B3F" />
                <path d="M8.5 7h7a9 9 0 0 1 0 18h-7z" fill="#FFFFFF" />
                <circle cx="16" cy="16" r="3.4" fill="#F29D12" />
                <path d="M21 16h1.2M16 21v1.2M11 16H9.8M16 11V9.8M19.4 19.4l.8.8M12.6 19.4l-.8.8M12.6 12.6l-.8-.8M19.4 12.6l.8-.8"
                      stroke="#F29D12" stroke-width="1.4" stroke-linecap="round" fill="none" />
            </svg>
            <span class="de-wordmark"><b>Dymo</b><span>Energy</span></span>
            <span class="de-admin-pill">ADMIN</span>
        </div>

        <h2 class="de-headline">Run your solar business from one place.</h2>
        <p class="de-lede">
            Orders, quote requests, installations, stock and service &mdash;
            all in the DymoEnergy admin portal.
        </p>

        <div class="de-mock" aria-hidden="true">
            <div class="de-mock-bar">
                <i></i><i></i><i></i><b>Dashboard</b>
            </div>
            <div class="de-mock-cards">
                <div class="de-mini"><u>New orders</u><s class="g"></s></div>
                <div class="de-mini"><u>Quote requests</u><s class="a"></s></div>
                <div class="de-mini"><u>Installations</u><s class="b"></s></div>
            </div>
            <div class="de-rows">
                <div class="de-row">
                    <span class="de-sq" style="background:#DCEDE2"></span>
                    <span class="de-ln" style="width:56%"></span>
                    <span class="de-pl" style="background:#FBE7C4"></span>
                </div>
                <div class="de-row">
                    <span class="de-sq" style="background:#DCE4F7"></span>
                    <span class="de-ln" style="width:44%"></span>
                    <span class="de-pl" style="background:#D8E2F8"></span>
                </div>
                <div class="de-row">
                    <span class="de-sq" style="background:#FBEBD2"></span>
                    <span class="de-ln" style="width:62%"></span>
                    <span class="de-pl" style="background:#D6EADE"></span>
                </div>
                <div class="de-row">
                    <span class="de-sq" style="background:#E3DEF6"></span>
                    <span class="de-ln" style="width:38%"></span>
                    <span class="de-pl" style="background:#FBE7C4"></span>
                </div>
            </div>
        </div>

        <div class="de-secure">
            <div>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4" />
                </svg>
                2-step verification
            </div>
            <div>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
                Encrypted connection
            </div>
            <div>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="8" r="4" /><path d="M2 21a7 7 0 0 1 14 0M18 8l2 2 3-3" />
                </svg>
                Role-based access
            </div>
        </div>
    </div>

    <!-- ══ RIGHT ═══════════════════════════════════════════════════════ -->
    <div class="de-right">

        <div class="de-formwrap">
            <div class="de-form">
                <h1>Sign in</h1>
                <p class="sub">Use your DymoEnergy staff account.</p>

                @if (!Model.IsExternalLoginOnly)
                {
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="de-alert" role="alert">
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" asp-for="ReturnUrlHash" />

                        <label class="de-label" asp-for="LoginInput.UserNameOrEmailAddress">Email or username</label>
                        <div class="de-field">
                            <svg class="lead" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" />
                            </svg>
                            <input asp-for="LoginInput.UserNameOrEmailAddress"
                                   type="text"
                                   placeholder="admin&#64;dymoenergy.com"
                                   autocomplete="username"
                                   autofocus />
                        </div>

                        <div class="de-label-row">
                            <label class="de-label" asp-for="LoginInput.Password">Password</label>
                            <a class="de-forgot" asp-page="./ForgotPassword"
                               asp-route-returnUrl="@Model.ReturnUrl">Forgot password?</a>
                        </div>
                        <div class="de-field">
                            <svg class="lead" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                            <input asp-for="LoginInput.Password"
                                   type="password"
                                   id="de-pwd"
                                   placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;"
                                   autocomplete="current-password" />
                            <button type="button" class="de-eye" id="de-eye-btn" aria-label="Show password">
                                <svg id="de-eye-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>

                        <label class="de-keep">
                            <input asp-for="LoginInput.RememberMe" type="checkbox" />
                            Keep me signed in on this device for 7 days
                        </label>

                        <button type="submit" name="Action" value="Login" class="de-submit">
                            Sign in
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h13M13 6l6 6-6 6" />
                            </svg>
                        </button>
                    </form>
                }

                @if (Model.VisibleExternalProviders.Any())
                {
                    <div class="de-divider"></div>
                    <p class="de-help">Or continue with</p>
                    <div class="de-ext">
                        @foreach (var provider in Model.VisibleExternalProviders)
                        {
                            <form asp-page="./Login" asp-page-handler="ExternalLogin"
                                  asp-route-returnUrl="@Model.ReturnUrl"
                                  asp-route-returnUrlHash="@Model.ReturnUrlHash"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="@provider.AuthenticationScheme" />
                                <button type="submit">@provider.DisplayName</button>
                            </form>
                        }
                    </div>
                }

                <div class="de-divider"></div>
                <p class="de-help">
                    Staff only. Need an account or locked out?<br />
                    Contact your system administrator at
                    <a href="mailto:it&#64;dymoenergy.com">it&#64;dymoenergy.com</a>
                </p>
            </div>
        </div>

        <div class="de-bottom">
            <span>&copy; @DateTime.Now.Year Dymo Energy</span>
            <span>
                Admin portal &middot;
                <a href="/Account/PrivacyPolicy">Privacy</a> &middot;
                <a href="https://www.dymoenergy.com" target="_blank" rel="noopener">Go to storefront &#8599;</a>
            </span>
        </div>
    </div>

    <script>
        (function () {
            var btn = document.getElementById('de-eye-btn');
            var pwd = document.getElementById('de-pwd');
            if (!btn || !pwd) { return; }

            btn.addEventListener('click', function () {
                var showing = pwd.type === 'text';
                pwd.type = showing ? 'password' : 'text';
                btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
                pwd.focus();
            });
        })();
    </script>
</body>
</html>
